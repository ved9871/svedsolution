* text=auto eol=lf

# Mark binaries explicitly rather than relying on text=auto detection, so no
# platform's line-ending normalisation can ever corrupt a font or image.
*.woff2 binary
*.woff  binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.avif  binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.xlsx  binary
*.docx  binary
