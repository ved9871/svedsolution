/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Content-hashed bundles (style.<hash>.css, app.<hash>.js) — safe to pin
# forever, because any edit changes the filename.
/assets/*.*.css
  Cache-Control: public, max-age=31536000, immutable

/assets/*.*.js
  Cache-Control: public, max-age=31536000, immutable

# Everything else under /assets is served on a stable filename, so it must
# revalidate. Pinning these was what stopped CSS changes reaching browsers.
/assets/*
  Cache-Control: public, max-age=3600, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/admin/*
  X-Robots-Tag: noindex, nofollow

/api/*
  Cache-Control: no-store
